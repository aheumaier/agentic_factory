# Build context for sandbox/swe-agent/Dockerfile is the repo root (it is
# uploaded to E2B's builder). Keep secrets and bulky local state out of it:
# .env holds seat OAuth tokens (specs/009) and other credentials.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.claude/
.git/
**/.venv/
**/__pycache__/
**/*.pyc
.ruff_cache/
.pytest_cache/
node_modules/
docs/
*.pdf
*.tar.gz
