{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Spec",
  "description": "Structured intake artifact (§3.1 Spec/Intake). One file per requested agent, versioned in git alongside the registry entry it produces.",
  "type": "object",
  "required": ["name", "owner", "goal", "tools", "guardrails", "success_criteria"],
  "properties": {
    "name": { "type": "string", "description": "Unique agent identifier, kebab-case" },
    "owner": { "type": "string", "description": "Human accountable for this agent" },
    "goal": { "type": "string", "description": "What the agent does, one paragraph" },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "MCP tool names / SKILL.md refs this agent is allowed to bind"
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "requires_human_approval": { "type": "array", "items": { "type": "string" } }
      }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Eval/Gate (§3.6) scores against these"
    },
    "triage": {
      "type": "object",
      "properties": {
        "decision": { "type": "string", "enum": ["auto-approve", "escalate", "rejected"] },
        "rule_matched": { "type": "string" }
      }
    }
  }
}
