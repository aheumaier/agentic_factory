# Inference Routing (§3.4) — LiteLLM proxy, keys stay behind it
ANTHROPIC_PLATFORM_API_KEY=

# LiteLLM proxy auth for callers inside the factory
LITELLM_MASTER_KEY=sk-local-master

# Orchestration (§3.5) — Temporal's backing Postgres
TEMPORAL_DB_PASSWORD=temporal

# Observability (§3.8) — Langfuse's backing stores + app secrets
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Eval/Gating (§3.6) — Braintrust has no self-host tier; pilot fits free tier
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=agent-factory-pilot

# Execution Sandbox (§3.3) — E2B has no self-host tier; pilot fits free/Hobby tier
E2B_API_KEY=

# Orchestration (§3.5) — webhook trigger bridge (specs/002-webhook-trigger-bridge)
# GH_WEBHOOK_SECRET: shared HMAC secret configured on the swe-agent GitHub App's webhook settings.
GH_WEBHOOK_SECRET=
# WEBHOOK_PROXY_URL: a smee.io/<channel> URL. SECRET — smee.io channels are public/unauthenticated
# for reads; anyone with this URL can read every relayed webhook delivery in full.
WEBHOOK_PROXY_URL=
# BRIDGE_PORT: local bind port for the bridge's /webhook route (default 3000; loopback-only).
BRIDGE_PORT=3000
# BRIDGE_ALLOWED_REPOS: comma-separated owner/repo allowlist. MUST be a disposable/test repo only
# until specs/005-pipeline-mode-signals-escalation ships — AgentPipelineWorkflow has no human gate yet.
BRIDGE_ALLOWED_REPOS=
# SWE_AGENT_APP_ID: the existing swe-agent GitHub App's numeric ID (reused, not a second App).
SWE_AGENT_APP_ID=
# SWE_AGENT_APP_PRIVATE_KEY: that App's private key, PEM, base64-encoded (encode with
# `base64 -i private-key.pem`) — base64, not literal/`\n`-escaped PEM, to avoid .env quoting issues.
SWE_AGENT_APP_PRIVATE_KEY=
